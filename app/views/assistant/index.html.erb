<main class="page-shell">
  <div class="container">
    <div class="page-heading">
      <%= link_to "← Back home", root_path, class: "back-link" %>
      <span class="eyebrow">HERE FOR YOUR QUESTIONS</span>
      <h1>AI Assistant</h1>
      <p>Ask about work, safety, or welfare schemes. Get a simple answer in the language you choose.</p>
    </div>

    <section class="workspace-card chat-card" aria-labelledby="chat-title">
      <div class="workspace-intro">
        <span class="card-icon icon-purple" aria-hidden="true">✳</span>
        <div><h2 id="chat-title">Your GigSaathi chat</h2><p>Ask a question and continue the conversation without leaving this page.</p></div>
      </div>

      <div class="chat-messages" data-chat-messages aria-label="Chat messages" aria-live="polite" aria-relevant="additions text">
        <article class="chat-message assistant-message">
          <span class="chat-avatar" aria-hidden="true">g</span>
          <div class="chat-bubble">
            <strong>GigSaathi</strong>
            <p>Namaste! Ask me about worker safety, rights, or welfare schemes. I’ll do my best to help.</p>
          </div>
        </article>
      </div>

      <p class="chat-status field-help" data-chat-status role="status" aria-live="polite"></p>
      <div class="notice notice-error" data-chat-error role="alert" <%= "hidden" unless @error.present? %>><%= @error %></div>

      <%= form_with url: ask_assistant_path, method: :post, class: "chat-form", data: { chat_form: true, turbo: false } do |form| %>
        <div class="field field-short">
          <%= form.label :language, "Reply in" %>
          <%= form.select :language, [["English", "english"], ["Hindi", "hindi"], ["Hinglish", "hinglish"]], { selected: @language || "english" } %>
        </div>
        <div class="chat-composer">
          <div class="field chat-input-field">
            <%= form.label :question, "Your message", class: "visually-hidden" %>
            <%= form.text_area :question, rows: 2, maxlength: 2000, placeholder: "Type your question here…", required: true, data: { chat_input: true }, aria: { describedby: "chat-privacy-note" } %>
          </div>
          <%= form.button "Send", type: :submit, class: "button button-primary chat-send", data: { chat_submit: true } do %>
            <span data-chat-submit-label>Send</span><span aria-hidden="true">&rarr;</span>
          <% end %>
        </div>
        <span id="chat-privacy-note" class="field-help">Press Enter to send or Shift+Enter for a new line. Don't share passwords or sensitive personal details. Messages are sent to your configured AI provider.</span>
      <% end %>
    </section>
    <div class="info-strip"><span aria-hidden="true">ⓘ</span><p>AI can make mistakes and does not replace legal advice. Scheme rules vary by location; check current details with an official government source.</p></div>
  </div>
</main>
